# Copy to .env and fill in real values (never commit .env to source control)

# SQL Server connection string for the MCP server
SQL_CONNECTION_STRING=Server=sqlserver;Database=MyDatabase;User Id=sa;Password=YourPassword123!;Encrypt=true;TrustServerCertificate=true;

# SQL Server SA password (used by the sqlserver container)
SQL_SA_PASSWORD=YourStrongPassword123!

# Image tag for mcp-server (default: latest)
TAG=latest
