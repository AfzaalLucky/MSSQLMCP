{
  "Mcp": {
    "MaxConcurrentTools": 20
  },
  "SqlServer": {
    "CommandTimeoutSeconds": 60,
    "ConnectTimeoutSeconds": 30,
    "MaxPoolSize": 20,
    "MinPoolSize": 1,
    "Encrypt": false,
    "TrustServerCertificate": true,
    "MaxRowsPerQuery": 5000
  },
  "Security": {
    "EnableQuerySafetyValidation": true,
    "AllowWriteOperations": false,
    "MaxResultRows": 5000,
    "MaxQueryTimeoutSeconds": 120
  },
  "Telemetry": {
    "OtlpEndpoint": null,
    "EnableMetrics": true,
    "EnableTracing": true,
    "SamplingRatio": 1.0
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultTtlSeconds": 60,
    "SchemasTtlSeconds": 120,
    "DefinitionsTtlSeconds": 120,
    "StatisticsTtlSeconds": 30,
    "DatabaseListTtlSeconds": 300
  },
  "Tools": {
    "DefaultPageSize": 10,
    "SampleDataRowCount": 20,
    "DatabaseListCacheTtl": 300,
    "SchemasCacheTtl": 120,
    "ObjectsCacheTtl": 60,
    "DefinitionsCacheTtl": 120,
    "StatisticsCacheTtl": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    },
    "LogPath": null,
    "SeqEndpoint": null
  }
}
