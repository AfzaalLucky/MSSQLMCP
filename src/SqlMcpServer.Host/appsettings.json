{
  "Mcp": {
    "ServerName": "SQL MCP Server",
    "Version": "1.0.0",
    "Description": "Enterprise MCP Server for Microsoft SQL Server",
    "MaxConcurrentTools": 10
  },
  "SqlServer": {
    "ConnectionString": "",
    "AuthMode": "WindowsAuth",
    "CommandTimeoutSeconds": 30,
    "ConnectTimeoutSeconds": 15,
    "MaxPoolSize": 100,
    "MinPoolSize": 5,
    "Encrypt": true,
    "TrustServerCertificate": false,
    "AzureScope": "https://database.windows.net/.default",
    "MaxRowsPerQuery": 10000
  },
  "Security": {
    "EnableQuerySafetyValidation": true,
    "AllowWriteOperations": false,
    "AllowDdl": false,
    "AllowDml": false,
    "MaxResultRows": 10000,
    "MaxQueryTimeoutSeconds": 300,
    "DeniedKeywords": [
      "xp_cmdshell",
      "sp_configure",
      "OPENROWSET",
      "OPENDATASOURCE",
      "OPENQUERY",
      "SHUTDOWN",
      "RECONFIGURE",
      "BULK INSERT"
    ]
  },
  "Telemetry": {
    "ServiceName": "SqlMcpServer",
    "OtlpEndpoint": null,
    "EnableMetrics": true,
    "EnableTracing": true,
    "EnableLogging": true,
    "SamplingRatio": 1.0
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnectionString": null,
    "DefaultTtlSeconds": 300,
    "SchemasTtlSeconds": 600,
    "DefinitionsTtlSeconds": 900,
    "StatisticsTtlSeconds": 120,
    "DatabaseListTtlSeconds": 1800
  },
  "Tools": {
    "EnabledTools": [],
    "DefaultPageSize": 25,
    "MaxPageSize": 500,
    "SampleDataRowCount": 100,
    "DatabaseListCacheTtl": 1800,
    "SchemasCacheTtl": 600,
    "ObjectsCacheTtl": 300,
    "DefinitionsCacheTtl": 900,
    "StatisticsCacheTtl": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "LogPath": null,
    "SeqEndpoint": null
  },
  "KeyVault": {
    "Uri": null
  }
}
